    {"name": "marhalábszár kockázva", "quantity": 1.0, "unit": "kg"},
    {"name": "burgonya", "quantity": 1.0, "unit": "kg"},
    {"name": "vöröshagyma", "quantity": 3, "unit": "db"},
    {"name": "sárgarépa", "quantity": 2, "unit": "db"},
    {"name": "zeller (gumó)", "quantity": 0.5, "unit": "db"},
    {"name": "paradicsom (sűrített)", "quantity": 2, "unit": "ek"},
    {"name": "paprika (őrölt, csípős is)", "quantity": 2, "unit": "tk"},
